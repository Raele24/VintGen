{
  "name": "vintgen",
  "version": "1.0.3",
  "description": "Open-Source AI Listing Generator for Secondhand Marketplaces",
  "bin": {
    "vintgen": "bin/vintgen.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node18 --outfile=dist/index.js",
    "start": "node ./bin/vintgen.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT",
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Raele24/VintGen.git",
    "directory": "packages/cli"
  },
  "homepage": "https://vintgen-ai.vercel.app",
  "bugs": {
    "url": "https://github.com/Raele24/VintGen/issues"
  },
  "keywords": [
    "vinted",
    "secondhand",
    "reselling",
    "listing-generator",
    "gemini",
    "vision-ai",
    "cli"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}