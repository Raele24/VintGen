{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VintGen",
  "version": "1.0.1",
  "identifier": "com.vintgen.desktop",
  "build": {
    "beforeDevCommand": "npm run web",
    "devUrl": "http://localhost:4200",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../apps/web/dist/web/browser"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VintGen — AI Secondhand Listing Generator",
        "url": "https://vintgen-ai.vercel.app",
        "width": 1280,
        "height": 850,
        "minWidth": 480,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}