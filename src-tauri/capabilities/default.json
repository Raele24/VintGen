{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for VintGen Desktop with live OTA update support",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "opener:allow-default-urls"
  ],
  "remote": {
    "urls": [
      "https://vintgen-ai.vercel.app*",
      "http://localhost:4200*"
    ]
  }
}